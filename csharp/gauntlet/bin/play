#!/bin/bash
# Build Gauntlet with Unity in the background (no editor window), launch it, and stream its log here.
# Usage: bin/play          (Ctrl+C stops the log; close the game window to quit the game)
set -u
NO_RUN=0; [ "${1:-}" = "--no-run" ] && NO_RUN=1
cd "$(dirname "$0")/.."
UNITY="/Applications/Unity/Hub/Editor/$(sed -n 's/^m_EditorVersion: //p' ProjectSettings/ProjectVersion.txt)/Unity.app/Contents/MacOS/Unity"
LOG="Logs/build.log"
PLAYER_LOG="$HOME/Library/Logs/DefaultCompany/Gauntlet/Player.log"
mkdir -p Logs

if pgrep -f "Unity.*-batchmode.*-projectPath $(pwd)" >/dev/null; then
  echo "🟡 a build of this project is already running (another bin/play). Wait for it, then try again."; exit 1
fi
if pgrep -f "Unity.app/Contents/MacOS/Unity.*-projectPath.*$(pwd)" >/dev/null; then
  echo "🔴 The Unity editor has this project open. Close it first (batch mode cannot share the project)."; exit 1
fi
pkill -f "Builds/Gauntlet.app/Contents/MacOS" 2>/dev/null
"$(dirname "$0")/sync-csproj" >/dev/null 2>&1

echo "🔨 building (low CPU priority, ~1 min)..."
START=$(date +%s)
taskpolicy -b "$UNITY" -batchmode -quit -projectPath "$(pwd)" -executeMethod GauntletBuild.PlayBuild -logFile "$LOG"
CODE=$?

ERRORS=$(grep -aE "error CS[0-9]+" "$LOG" | sed -E 's#^.*(Assets/[^(]+\(([0-9]+),([0-9]+)\)): error (CS[0-9]+): (.*)$#\1  \4  \5#' | sort -u)
if [ -n "$ERRORS" ]; then
  echo "🔴 your code does not compile:"; echo "$ERRORS"; exit 1
fi
if [ $CODE -ne 0 ] || [ ! -d Builds/Gauntlet.app ]; then
  echo "🔴 build failed (exit $CODE). Last lines of $LOG:"; grep -aE "GAUNTLET|Exception|error" "$LOG" | tail -15; exit 1
fi
grep -a "GAUNTLET:" "$LOG" | grep -vE "size \(" | sed 's/^/   /'
[ $NO_RUN = 1 ] && { echo "✅ built in $(( $(date +%s) - START ))s (not launched)"; exit 0; }
echo "✅ built in $(( $(date +%s) - START ))s, launching. Your Debug.Log lines appear below (Ctrl+C to stop watching)."
[ -f "$PLAYER_LOG" ] && : > "$PLAYER_LOG"
open Builds/Gauntlet.app
sleep 2
# show only what happens after Unity's start-up chatter: your Debug.Log lines, warnings, errors
tail -n +1 -F "$PLAYER_LOG" 2>/dev/null | awk '/Finished resetting the current domain/ {on=1; next} on && !/^\(Filename:/ && !/^\[Physics/ && !/^UnloadTime/ && NF {print; fflush()}'
